# Caddyfile canonique du VPS Brozapi — contient TOUS les domaines servis par cette instance.
# ATTENTION : ce fichier est copié sur /etc/caddy/Caddyfile par accessicheck-deploy.sh.
# Ne jamais réduire cette config à un seul domaine : le déploiement suivant écraserait les autres blocs.
# Doit refléter EXACTEMENT l'état du fichier live /etc/caddy/Caddyfile (blocs www + redir inclus).

api.brozapi.com {
    handle /accessicheck/lead {
        reverse_proxy 127.0.0.1:8080
    }

    handle_path /accessicheck/* {
        reverse_proxy 127.0.0.1:8081
    }

    reverse_proxy 127.0.0.1:8080

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
        -Server
    }
}

# Redirection 301 explicite http -> https pour brozapi.com et www.brozapi.com
# (l'auto-redirect Caddy renvoie 308 ; le défaut du navigateur est acceptable,
#  mais on force 301 pour un comportement SEO déterministe).
http://brozapi.com, http://www.brozapi.com {
    redir https://brozapi.com{uri} permanent

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

brozapi.com {
    root * /var/www/brozapi
    file_server
    encode zstd gzip

    # Redirections 301 des anciennes URLs (ancien site encore indexé par Google, août 2026)
    redir /preuve-d-achat-et-garantie https://brozapi.com/ permanent
    redir /preuve-d-achat-et-garantie/ https://brozapi.com/ permanent
    redir /blog https://brozapi.com/ permanent
    redir /blog/ https://brozapi.com/ permanent
    redir /blog/* https://brozapi.com/ permanent
    redir /politique-de-confidentialite /mentions-legales.html permanent
    redir /politique-de-confidentialite/ /mentions-legales.html permanent
    # Variantes avec extension .html (404 signalés en Search Console, 23/08)
    redir /preuve-d-achat-et-garantie.html https://brozapi.com/ permanent
    redir /blog.html https://brozapi.com/ permanent
    redir /guide.html https://brozapi.com/ permanent

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://badgeia.brozapi.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.brozapi.com; font-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'"
        -Server
    }
}

www.brozapi.com {
    redir https://brozapi.com{uri} permanent
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        -Server
    }
}

# app.brozapi.com — sous-domaine applicatif (pas de service actif pour l'instant).
# Décision SEO (23/08/2026, carte t_7e457034) : Google explorait des assets Next.js
# sur ce sous-domaine. On répond 410 Gone + robots disallow all : c'est un sous-domaine
# technique/app, pas du contenu à indexer. Quand l'app y sera déployée, ajouter ici
# un reverse_proxy + robots.txt noindex.
app.brozapi.com {
    respond /robots.txt 200 {
        body "User-agent: *
Disallow: /
"
        close
    }
    respond 410

    header {
        X-Content-Type-Options nosniff
        -Server
    }
}
# citescan.brozapi.com — CiteScan (conteneur citescan-api, port 8083). Carte 3.4 (23/08/2026).
# NOTE : DNS du sous-domaine pas encore créé (action Franck, zone OVH) — le certificat
# TLS sera émis automatiquement dès que l'enregistrement A/CNAME pointera sur le VPS.
citescan.brozapi.com {
    reverse_proxy 127.0.0.1:8083

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
        -Server
    }
}

# DODOS-BEGIN (carte t_53f2af1d, 03/09/2026) — Dodos by Brozapi : site statique
# /var/www/dodos + API commandes (conteneur dodos-api, port 8084).
dodos.brozapi.com {
    handle_path /api/* {
        reverse_proxy 127.0.0.1:8084 {
            header_up X-Real-IP {remote_host}
        }
    }
    root * /var/www/dodos
    file_server
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        -Server
    }
}
# DODOS-END
